<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="content-type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="./images/favicon.ico">
  <title>Personal NFT Mint</title>
  <meta name="author" content="Jonathan J. Schroeder">
  <meta name="description" content="A personal NFT mint for an artist.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Audiowide&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
  <link rel="stylesheet" href="./css/style.css">
</head>

<body>
  <!-- header section that remains anchored to the top of the page -->

  <%- include('header'); %>



    <!-- Splash area introduction -->
    <section>
      <div id="splash" class="area">
        <div class="spacer"></div>
        <div id="hero-text" class="position-absolute top-50 start-50 translate-middle text-light text-center">
          <h1 class="display-1">Jonathan J. Schroeder</h1>
          <h2>Audio Engineer, Educator, and <br>Visual Artist</h2>
          <p>Generative Art NFT Gallery</p>
        </div>
      </div>
    </section>


    <!-- Featured project section with ejs-->
    <!-- let selectedProject = 0; -->
    <%- include('featuredProjectCard', { name: projectArray[2].project_name, image: projectArray[2].img_url,
      description: projectArray[2].project_description, ident: projectArray[2].id}); %>




      <!--Project Gallery section-->
      <div class="row">
        <section id="Project-Gallery" class=" pt-5 pb-0 text-center container mx-0">
          <div class="row justify-content-center">
            <div class="col justify-content-center mx-auto">
              <h1 class="fw-light ">NFT Project Gallery</h1>
              <p class="lead text-body-secondary ">
                Voluptate minim sit enim proident proident voluptate aliqua eiusmod consectetur.
              </p>
            </div>
          </div>
        </section>
      </div>

      <!-- Dynamic Option for the project gallery -->
      <div class="container">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4">

          <% projectArray.forEach((item, index)=> { %>
            <div class="col">
              <%- include('projectCard', {ident: item.id, image: item.img_url, name: item.project_name}); %>
            </div>
            <% }); %>

        </div>
      </div>



      <!--About the Artist Section-->
      <div id="Artist-About" class="container col-xxl-8 px-4 py-5">
        <div class="row flex-lg-row-reverse align-items-center g-5 py-5 h-100">
          <div class="col-10 col-sm-8 col-lg-6">
            <img src="./images/JJSAudio_Profile.png" class="d-block mx-lg-auto img-fluid" alt="Bootstrap Themes"
              width="200" height="200" loading="lazy" />
          </div>
          <div class="col-lg-6">
            <h1 class="display-5 fw-bold  lh-1 mb-3 ">
              About the Artist
            </h1>
            <p class="lead ">
              Reprehenderit nostrud ea nulla enim voluptate voluptate esse aliquip incididunt sit tempor. In id anim
              nulla
              elit labore. Cupidatat mollit laborum pariatur occaecat do elit aliqua irure occaecat est. Mollit ad ipsum
              laboris mollit ad velit quis velit sint ea reprehenderit excepteur excepteur. Consectetur non minim aute
              commodo duis deserunt eiusmod ullamco ex occaecat ex exercitation. Aliqua in eiusmod adipisicing enim esse
              nostrud ex nostrud.
            </p>
            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
              <a href="/contact">
                <button type="button" class="btn btn-primary btn-lg px-4 me-md-2">
                  Contact the Artist
                </button>
              </a>
              <!-- <button
                type="button"
                class="btn btn-outline-secondary btn-lg px-4"
              >
                Default
              </button> -->
            </div>
          </div>
        </div>
      </div>

      <!-- Footer for page with social links -->
      <%- include('footer'); %>


        <!-- Scripts for bootstrap and javascript functionality  -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4" crossorigin="anonymous">
          </script>
        <script type="module" src="./js/index.js"></script>
</body>

</html>